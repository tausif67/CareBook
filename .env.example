NODE_ENV=development
PORT=4000
ADMIN_WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://carebook:replace-local-database-password@localhost:5432/carebook?schema=public
POSTGRES_DB=carebook
POSTGRES_USER=carebook
POSTGRES_PASSWORD=replace-local-database-password
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ALLOW_LOCAL_OTP=false
LOCAL_OTP_CODE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ENABLE_TEST_PAYMENT=false
SEED_TEST_DATA=false
GOOGLE_MAPS_API_KEY=
FCM_ENABLED=false
OBJECT_STORAGE_BUCKET=carebook-private
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY=carebook-local
OBJECT_STORAGE_SECRET_KEY=replace-local-secret
OBJECT_STORAGE_KMS_KEY_ID=
DOCUMENT_UPLOAD_URL_TTL_SECONDS=600
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=300
DOCUMENT_MAX_SIZE_BYTES=10485760
APPOINTMENT_HOLD_MINUTES=10
RESCHEDULE_MIN_NOTICE_MINUTES=120
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
