CAREBOOK_ENV_FILE=.env.testing
NODE_ENV=development
PORT=4000
ADMIN_WEB_ORIGIN=http://localhost:8080,http://localhost:5173
DATABASE_URL=GENERATED_BY_TESTING_UP
POSTGRES_DB=carebook
POSTGRES_USER=carebook
POSTGRES_PASSWORD=GENERATED_BY_TESTING_UP
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=GENERATED_BY_TESTING_UP
JWT_ACCESS_TTL=12h
ALLOW_LOCAL_OTP=true
LOCAL_OTP_CODE=GENERATED_BY_TESTING_UP
ENABLE_TEST_PAYMENT=true
SEED_TEST_DATA=true
TEST_ADMIN_PHONE_E164=GENERATED_BY_TESTING_UP
RAZORPAY_WEBHOOK_SECRET=GENERATED_BY_TESTING_UP
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_MAPS_API_KEY=
OBJECT_STORAGE_BUCKET=carebook-private
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY=GENERATED_BY_TESTING_UP
OBJECT_STORAGE_SECRET_KEY=GENERATED_BY_TESTING_UP
OBJECT_STORAGE_KMS_KEY_ID=
DOCUMENT_UPLOAD_URL_TTL_SECONDS=600
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=300
DOCUMENT_MAX_SIZE_BYTES=10485760
APPOINTMENT_HOLD_MINUTES=10
RESCHEDULE_MIN_NOTICE_MINUTES=0
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
VITE_ENABLE_TEST_AUTH=true
