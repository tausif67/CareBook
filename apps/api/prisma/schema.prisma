generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum DoctorStatus {
  DRAFT
  PENDING_VERIFICATION
  CORRECTION_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsultationType {
  CLINIC
  ONLINE
}

enum AppointmentStatus {
  PAYMENT_PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_DOCTOR
  EXPIRED
  PAYMENT_REVIEW
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  firebaseUid  String?      @unique @map("firebase_uid")
  phoneE164    String       @unique @map("phone_e164")
  email        String?      @unique
  displayName  String       @map("display_name")
  role         UserRole
  status       UserStatus   @default(ACTIVE)
  locale       String       @default("en-IN")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  patient      Patient?
  doctor       Doctor?
  admin        AdminUser?
  notifications Notification[]
  deviceTokens  DeviceToken[]
  auditActions AuditLog[]   @relation("AuditActor")

  @@map("users")
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  platform   String
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@map("device_tokens")
}

model Patient {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @unique @map("user_id") @db.Uuid
  dateOfBirth DateTime?     @map("date_of_birth") @db.Date
  gender      String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  reviews      Review[]
  couponUsage  CouponUsage[]

  @@map("patients")
}

model Doctor {
  id                    String          @id @default(uuid()) @db.Uuid
  userId                String          @unique @map("user_id") @db.Uuid
  status                DoctorStatus    @default(DRAFT)
  registrationNumber    String?         @map("registration_number")
  registrationCouncil   String?         @map("registration_council")
  registrationYear      Int?            @map("registration_year")
  gender                String?
  qualifications        Json            @default("[]")
  experienceYears       Int             @default(0) @map("experience_years")
  about                  String?
  languages              String[]        @default(["English", "Hindi"])
  photoUrl               String?         @map("photo_url")
  clinicFeePaise         Int             @default(0) @map("clinic_fee_paise")
  onlineFeePaise         Int?            @map("online_fee_paise")
  onlineEnabled          Boolean         @default(false) @map("online_enabled")
  averageRating          Decimal         @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount            Int             @default(0) @map("review_count")
  submittedAt            DateTime?       @map("submitted_at") @db.Timestamptz(6)
  verifiedAt             DateTime?       @map("verified_at") @db.Timestamptz(6)
  verificationNotes      String?         @map("verification_notes")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents              DoctorDocument[]
  specializations        DoctorSpecialization[]
  clinics                ClinicDoctor[]
  schedules              DoctorSchedule[]
  appointments           Appointment[]
  reviews                Review[]
  commissionRules        CommissionRule[]

  @@index([status, averageRating])
  @@map("doctors")
}

model DoctorDocument {
  id          String         @id @default(uuid()) @db.Uuid
  doctorId    String         @map("doctor_id") @db.Uuid
  type        String
  storageKey  String         @unique @map("storage_key")
  checksum    String
  fileName    String?        @map("file_name")
  contentType String?        @map("content_type")
  sizeBytes   Int?           @map("size_bytes")
  uploadedAt  DateTime?      @map("uploaded_at") @db.Timestamptz(6)
  status      DocumentStatus @default(PENDING)
  rejectionReason String?    @map("rejection_reason")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt  DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  doctor      Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, status])
  @@map("doctor_documents")
}

model Specialization {
  id          String                 @id @default(uuid()) @db.Uuid
  slug        String                 @unique
  nameEn      String                 @map("name_en")
  nameHi      String                 @map("name_hi")
  iconKey     String?                @map("icon_key")
  active      Boolean                @default(true)
  doctors     DoctorSpecialization[]

  @@map("specializations")
}

model DoctorSpecialization {
  doctorId         String         @map("doctor_id") @db.Uuid
  specializationId String         @map("specialization_id") @db.Uuid
  primary          Boolean        @default(false)
  doctor           Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Restrict)

  @@id([doctorId, specializationId])
  @@map("doctor_specializations")
}

model Clinic {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  phoneE164    String?         @map("phone_e164")
  email        String?
  payAtClinicEnabled Boolean @default(false) @map("pay_at_clinic_enabled")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  addresses    ClinicAddress[]
  doctors      ClinicDoctor[]
  schedules    DoctorSchedule[]
  appointments Appointment[]

  @@index([name])
  @@map("clinics")
}

model ClinicAddress {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  line1       String
  line2       String?
  area        String
  city        String
  state       String
  postalCode  String   @map("postal_code")
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([city, area])
  @@map("clinic_addresses")
}

model ClinicDoctor {
  clinicId String  @map("clinic_id") @db.Uuid
  doctorId String  @map("doctor_id") @db.Uuid
  active   Boolean @default(true)
  clinic   Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor   Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@id([clinicId, doctorId])
  @@map("clinic_doctors")
}

model DoctorSchedule {
  id                     String   @id @default(uuid()) @db.Uuid
  doctorId               String   @map("doctor_id") @db.Uuid
  clinicId               String?  @map("clinic_id") @db.Uuid
  dayOfWeek               Int      @map("day_of_week")
  startMinute             Int      @map("start_minute")
  endMinute               Int      @map("end_minute")
  breakStartMinute        Int?     @map("break_start_minute")
  breakEndMinute          Int?     @map("break_end_minute")
  slotDurationMinutes     Int      @default(30) @map("slot_duration_minutes")
  maxAppointmentsPerSlot Int      @default(1) @map("max_appointments_per_slot")
  consultationType       ConsultationType @map("consultation_type")
  active                  Boolean  @default(true)
  doctor                  Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic                  Clinic?  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek, active])
  @@map("doctor_schedules")
}

model Appointment {
  id                    String            @id @default(uuid()) @db.Uuid
  publicId              String            @unique @map("public_id")
  patientId             String            @map("patient_id") @db.Uuid
  doctorId              String            @map("doctor_id") @db.Uuid
  clinicId              String?           @map("clinic_id") @db.Uuid
  consultationType      ConsultationType  @map("consultation_type")
  status                AppointmentStatus @default(PAYMENT_PENDING)
  startAt               DateTime          @map("start_at") @db.Timestamptz(6)
  endAt                 DateTime          @map("end_at") @db.Timestamptz(6)
  timezone              String            @default("Asia/Kolkata")
  patientName           String            @map("patient_name")
  patientAge            Int               @map("patient_age")
  patientGender         String            @map("patient_gender")
  patientPhoneE164      String            @map("patient_phone_e164")
  reasonForVisit        String            @map("reason_for_visit")
  consultationFeePaise  Int               @map("consultation_fee_paise")
  platformFeePaise      Int               @map("platform_fee_paise")
  discountPaise         Int               @default(0) @map("discount_paise")
  totalPaise            Int               @map("total_paise")
  couponId              String?           @map("coupon_id") @db.Uuid
  holdExpiresAt         DateTime?          @map("hold_expires_at") @db.Timestamptz(6)
  idempotencyKey        String             @map("idempotency_key")
  cancellationReason    String?            @map("cancellation_reason")
  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  patient               Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor                Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  clinic                Clinic?            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  coupon                Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payments              Payment[]
  review                Review?
  statusHistory         AppointmentStatusHistory[]

  @@unique([patientId, idempotencyKey])
  @@index([doctorId, startAt, status])
  @@index([patientId, startAt])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id             String            @id @default(uuid()) @db.Uuid
  appointmentId  String            @map("appointment_id") @db.Uuid
  fromStatus     AppointmentStatus? @map("from_status")
  toStatus       AppointmentStatus  @map("to_status")
  reason         String?
  actorUserId    String?            @map("actor_user_id") @db.Uuid
  requestKey     String?            @unique @map("request_key")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  appointment    Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_status_history")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  appointmentId      String        @map("appointment_id") @db.Uuid
  provider           String        @default("razorpay")
  gatewayOrderId     String        @unique @map("gateway_order_id")
  gatewayPaymentId   String?       @unique @map("gateway_payment_id")
  amountPaise        Int           @map("amount_paise")
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  method             String?
  failureCode        String?       @map("failure_code")
  failureDescription String?       @map("failure_description")
  capturedAt         DateTime?     @map("captured_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointment        Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  refunds            Refund[]

  @@index([appointmentId, status])
  @@map("payments")
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  paymentId       String       @map("payment_id") @db.Uuid
  gatewayRefundId String?      @unique @map("gateway_refund_id")
  amountPaise     Int          @map("amount_paise")
  reason          String
  status          RefundStatus @default(PENDING)
  failureReason   String?      @map("failure_reason")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  payment         Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("refunds")
}

model Review {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @unique @map("appointment_id") @db.Uuid
  patientId     String      @map("patient_id") @db.Uuid
  doctorId      String      @map("doctor_id") @db.Uuid
  rating        Int
  comment       String?
  moderated     Boolean     @default(false)
  visible       Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([doctorId, visible, createdAt])
  @@map("reviews")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  channel   NotificationChannel
  template  String
  title     String
  body      String
  data      Json               @default("{}")
  status    NotificationStatus @default(QUEUED)
  scheduledAt DateTime?        @map("scheduled_at") @db.Timestamptz(6)
  sentAt    DateTime?          @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Coupon {
  id                  String      @id @default(uuid()) @db.Uuid
  code                String      @unique
  type                CouponType
  value               Int
  maximumDiscountPaise Int?       @map("maximum_discount_paise")
  minimumBookingPaise Int         @default(0) @map("minimum_booking_paise")
  startsAt            DateTime    @map("starts_at") @db.Timestamptz(6)
  expiresAt           DateTime    @map("expires_at") @db.Timestamptz(6)
  usageLimit          Int?        @map("usage_limit")
  perPatientLimit     Int         @default(1) @map("per_patient_limit")
  firstBookingOnly    Boolean     @default(false) @map("first_booking_only")
  active              Boolean     @default(true)
  appointments        Appointment[]
  usage               CouponUsage[]

  @@index([active, startsAt, expiresAt])
  @@map("coupons")
}

model CouponUsage {
  id            String   @id @default(uuid()) @db.Uuid
  couponId      String   @map("coupon_id") @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  discountPaise Int      @map("discount_paise")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([couponId, patientId])
  @@map("coupon_usage")
}

model CommissionRule {
  id                    String   @id @default(uuid()) @db.Uuid
  doctorId              String?  @map("doctor_id") @db.Uuid
  percentageBasisPoints Int      @default(0) @map("percentage_basis_points")
  fixedPlatformFeePaise Int      @default(0) @map("fixed_platform_fee_paise")
  patientConvenienceFeePaise Int @default(0) @map("patient_convenience_fee_paise")
  effectiveFrom         DateTime @map("effective_from") @db.Timestamptz(6)
  effectiveTo           DateTime? @map("effective_to") @db.Timestamptz(6)
  active                Boolean  @default(true)
  doctor                Doctor?  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, active, effectiveFrom])
  @@map("commission_rules")
}

model AdminUser {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  permissions String[] @default([])
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_users")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  before       Json?
  after        Json?
  ipHash       String?  @map("ip_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model PaymentWebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String   @map("event_id")
  eventType   String   @map("event_type")
  payloadHash String   @map("payload_hash")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

model OutboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  topic       String
  aggregateId String   @map("aggregate_id")
  payload     Json
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([processedAt, availableAt])
  @@map("outbox_events")
}
