{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json", "diagnostics": { "ignoreCodes": [151002] } }] },
  "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" },
  "testEnvironment": "node"
}
